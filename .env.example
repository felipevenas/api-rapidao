# Rapidão Delivery Platform Environment Configuration
PROJECT_NAME="Rapidão Delivery Platform"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=rapidao_user
POSTGRES_PASSWORD=rapidao_pass
POSTGRES_DB=rapidao_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# JWT Authentication & Security (Chave forte >= 32 caracteres)
JWT_SECRET=rapidao_super_secret_jwt_key_2026_production_safe_key_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# Celery Tasks Configuration
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
