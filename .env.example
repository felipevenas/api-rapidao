# App & API Settings
PROJECT_NAME="Rapidão Delivery API"
API_V1_STR="/api/v1"
SECRET_KEY="sua_chave_secreta_aqui_para_desenvolvimento"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rapidao_db
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5433/rapidao_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
